[include]
    path = ~/.gitconfig.local
    # per-machine (signingkey etc.); linked from home/.config/git/<machine>.gitconfig by bin/bootstrap
    path = ~/.config/git/machine.gitconfig

# dotfiles repo commits with personal identity on every machine, wherever it's cloned
[includeIf "gitdir:**/dotfiles/"]
    path = ~/.config/git/dotfiles.gitconfig

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[rebase]
  autoStash = true

[rerere]
  enabled = true

[merge]
	conflictStyle = zdiff3

[core]
  fileMode = true
	excludesFile = ~/.config/git/ignore

[log]
  decorate = short

[fetch]
  prune = true

[diff]
  colorMoved = zebra

[alias]
  st = status
  co = checkout
  br = branch
  ci = commit
  amend = commit --amend --no-edit
  unstage = reset HEAD --
  last = log -1 HEAD
  lg = log --graph --oneline --decorate --all
  wdiff = diff --color-words
[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true
