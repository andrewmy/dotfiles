{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://192.168.50.139:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-27b": {
          "name": "Qwen 3.6 27B"
        },
        "Qwen3.8-27B-MLX-Serve-8bit": {
          "name": "Qwen 3.8 27B"
        }
      }
    }
  },
  "providers": {
    "darkbloom": {
      "name": "Darkbloom (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["DARKBLOOM_API_KEY"],
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen3.5-35b-a3b": {
          "name": "Qwen 3.5 35B A3B",
          "limit": { "context": 262144, "output": 262144 }
        },
        "qwen3.6-35b-a3b-vl-mtp-mxfp8": {
          "name": "Qwen 3.6 35B A3B VL",
          "limit": { "context": 262144, "output": 262144 }
        },
        "ternary-bonsai-2-27b": {
          "name": "Ternary Bonsai 2 27B",
          "limit": { "context": 262144, "output": 262144 }
        }
      }
    }
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/gitnexus",
        "mcp"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server"
      ]
    },
    "wick": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/wick",
        "serve",
        "--mcp"
      ]
    },
    "browse": {
      "type": "local",
      "command": [
        "/Users/andr/.local/bin/browse",
        "mcp"
      ],
      "cwd": "/Users/andr",
      "pool": true,
      "environment": {
        "OPENCODE_BROWSER_RUNTIME": "auto-update"
      }
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-goal-plugin",
    "@dietrichgebert/ponytail"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  }
}
