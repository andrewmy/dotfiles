{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.agents/AGENTS.md", "~/.agents/RTK.md"],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://192.168.50.139:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-27b": {
          "name": "Qwen 3.6 27B"
        },
        "Qwen3.8-27B-MLX-Serve-8bit": {
          "name": "Qwen 3.8 27B"
        }
      }
    },
    "ds4": {
      "name": "ds4.c (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "dsv4-local"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (ds4.c local)",
          "limit": {
            "context": 200000,
            "output": 384000
          }
        }
      }
    }
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "mcp-compressor",
        "--compression-level",
        "high",
        "--toonify",
        "{\"mcpServers\":{\"gitnexus\":{\"command\":\"/opt/homebrew/bin/gitnexus\",\"args\":[\"mcp\"]}}}"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "mcp-compressor",
        "--compression-level",
        "high",
        "--toonify",
        "{\"mcpServers\":{\"context7\":{\"command\":\"npx\",\"args\":[\"-y\",\"@upstash/context7-mcp\"]}}}"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "mcp-compressor",
        "--compression-level",
        "high",
        "--toonify",
        "{\"mcpServers\":{\"playwright\":{\"command\":\"npx\",\"args\":[\"@playwright/mcp@latest\"]}}}"
      ]
    },
    "serena": {
      "type": "local",
      "command": [
        "mcp-compressor",
        "--compression-level",
        "high",
        "--toonify",
        "{\"mcpServers\":{\"serena\":{\"command\":\"uvx\",\"args\":[\"--from\",\"git+https://github.com/oraios/serena\",\"serena\",\"start-mcp-server\"]}}}"
      ]
    },
    "wick": {
      "type": "local",
      "command": [
        "mcp-compressor",
        "--compression-level",
        "high",
        "--toonify",
        "{\"mcpServers\":{\"wick\":{\"command\":\"/opt/homebrew/bin/wick\",\"args\":[\"serve\",\"--mcp\"]}}}"
      ]
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-goal-plugin",
    "@dietrichgebert/ponytail"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  }
}
