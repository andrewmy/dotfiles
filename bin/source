#!/usr/bin/env bash
set -euo pipefail

DOTFILES_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$DOTFILES_BIN_DIR/common.sh"

BACKUP="$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$HOME/.config"

backup_item() {
  local target="$1"
  if [ -e "$target" ] || [ -L "$target" ]; then
    mkdir -p "$BACKUP"
    local rel="${target#$HOME/}"
    local backup_target="$BACKUP/$rel"
    mkdir -p "$(dirname "$backup_target")"
    mv "$target" "$backup_target"
  fi
}

link_item() {
  local src="$1"
  local target="$2"
  mkdir -p "$(dirname "$target")"
  ln -sfn "$src" "$target"
}

link_with_backup() {
  local src="$1"
  local target="$2"

  if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
    return
  fi

  backup_item "$target"
  link_item "$src" "$target"
}

resolve_target
resolve_machine
set_platform_paths

link_all link_with_backup

if command -v code-insiders >/dev/null 2>&1; then
  echo "If this machine should define the shared VS Code Insiders extension set, run:"
  echo "  ./bin/vscode-insiders-extensions update"
fi

if command -v npm >/dev/null 2>&1; then
  echo "If this machine should define the shared npm globals, run:"
  echo "  ./bin/npm-globals update"
fi

if command -v gh >/dev/null 2>&1; then
  echo "If this machine should define the shared gh extensions, run:"
  echo "  ./bin/gh-extensions update"
fi

if command -v npx >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then
  echo "If this machine should define the shared agent skills, run:"
  echo "  ./bin/agent-skills update"
fi
