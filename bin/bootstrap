#!/usr/bin/env bash
set -euo pipefail

DOTFILES_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$DOTFILES_BIN_DIR/common.sh"

bootstrap_packages() {
  if [[ "$DOTFILES_TARGET" == "darwin" ]]; then
    local brewfile
    local brewfiles=("$DOTFILES_ROOT/packages/Brewfile")

    if ! xcode-select -p >/dev/null 2>&1; then
      xcode-select --install
      echo "Install Command Line Tools, then re-run ./bin/bootstrap"
      exit 1
    fi

    if ! command -v brew >/dev/null 2>&1; then
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    eval "$(/opt/homebrew/bin/brew shellenv || /usr/local/bin/brew shellenv)"
    brew trust arthur-ficial/tap deskflow/tap github/gh jez/formulae krishkrosh/apps mike-engel/jwt-cli robusta-dev/krr steipete/tap symfony-cli/tap wickproject/wick
    if [[ -n "$MACHINE_PROFILE" && -f "$DOTFILES_ROOT/packages/Brewfile.$MACHINE_PROFILE" ]]; then
      brewfiles+=("$DOTFILES_ROOT/packages/Brewfile.$MACHINE_PROFILE")
    else
      echo "No Homebrew profile for '${MACHINE:-unknown}' — installing shared packages only."
    fi
    for brewfile in "${brewfiles[@]}"; do
      brew bundle --file="$brewfile"
    done
    brew upgrade
    report_unmanaged_brew_packages "${brewfiles[@]}"
  else
    echo "Skipping Homebrew package bootstrap for linux."
  fi
}

bootstrap_uv_tools() {
  local manifest="$DOTFILES_ROOT/packages/uv-tools.txt"

  if [[ ! -f "$manifest" ]]; then
    return
  fi

  if ! command -v uv >/dev/null 2>&1; then
    echo "Skipping uv tools bootstrap: uv not available."
    return
  fi

  while IFS= read -r tool; do
    [[ -z "$tool" || "$tool" == \#* ]] && continue
    uv tool install "$tool"
  done < "$manifest"
}

bootstrap_znap() {
  local znap_dir="$HOME/.znap"

  [[ -r "$znap_dir/znap.zsh" ]] ||
    git clone --depth 1 https://github.com/marlonrichert/zsh-snap.git "$znap_dir"

  ZNAP_DIR="$znap_dir" zsh -fc '
    source "$ZNAP_DIR/znap.zsh"
    zstyle ":znap:*" repos-dir "$ZNAP_DIR/repos"
    znap clone \
      Aloxaf/fzf-tab \
      zsh-users/zsh-autosuggestions \
      zdharma-continuum/fast-syntax-highlighting
  '
}

bootstrap_neovim() {
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

  if ! command -v nvim >/dev/null 2>&1; then
    echo "Skipping Neovim bootstrap: nvim not available."
    return
  fi

  local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  rm -rf \
    "$data_home/nvim/site/parser" \
    "$data_home/nvim/lazy/nvim-treesitter/parser"

  nvim --headless -i NONE "+Lazy! restore" "+TSUpdate" +qa
}

bootstrap_agent_skills() {
  "$DOTFILES_BIN_DIR/agent-skills" install
  "$DOTFILES_BIN_DIR/agent-skills" upgrade
}

link() {
  local src="$1"
  local target="$2"

  mkdir -p "$(dirname "$target")"
  if [[ -d "$target" && ! -L "$target" ]]; then
    echo "link: '$target' is a real directory — remove manually first" >&2
    return 1
  fi
  ln -sfn "$src" "$target"
}

resolve_target
resolve_machine

if [[ "$DOTFILES_TARGET" == "linux" ]]; then
  # shellcheck source=linux.sh
  source "$DOTFILES_BIN_DIR/linux.sh"
fi

set_platform_paths
bootstrap_packages
bootstrap_uv_tools

if [[ "$DOTFILES_TARGET" == "linux" ]]; then
  bootstrap_linux_tools
fi

bootstrap_znap

HOME_CONFIG_ROOT="$DOTFILES_ROOT/home/.config"
APP_CONFIG_ROOT="$DOTFILES_ROOT/app-config"

for f in .zshrc .zprofile .zshenv .p10k.zsh .gitconfig; do
  link "$DOTFILES_ROOT/home/$f" "$HOME/$f"
done
link "$DOTFILES_ROOT/home/.zsh/functions" "$HOME/.zsh/functions"
link "$DOTFILES_ROOT/home/.zsh/keybindings.zsh" "$HOME/.zsh/keybindings.zsh"

link "$DOTFILES_ROOT/home/.claude/settings.json" "$HOME/.claude/settings.json"
link "$DOTFILES_ROOT/home/.claude/statusline-command.sh" "$HOME/.claude/statusline-command.sh"
link "$DOTFILES_ROOT/home/.claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md"

link "$DOTFILES_ROOT/home/.agents/AGENTS.md" "$HOME/.agents/AGENTS.md"
link "$DOTFILES_ROOT/home/.agents/RTK.md" "$HOME/.agents/RTK.md"
for skill_dir in "$DOTFILES_ROOT"/home/.agents/skills/*/; do
  link "${skill_dir%/}" "$HOME/.agents/skills/$(basename "$skill_dir")"
done

link "$HOME_CONFIG_ROOT/nvim" "$HOME/.config/nvim"
link "$HOME_CONFIG_ROOT/mc" "$HOME/.config/mc"
link "$HOME_CONFIG_ROOT/gh/config.yml" "$HOME/.config/gh/config.yml"
link "$HOME_CONFIG_ROOT/gh-dash/config.yml" "$HOME/.config/gh-dash/config.yml"
link "$HOME_CONFIG_ROOT/htop/htoprc" "$HOME/.config/htop/htoprc"
link "$HOME_CONFIG_ROOT/git/ignore" "$HOME/.config/git/ignore"
link "$HOME_CONFIG_ROOT/git/allowed_signers" "$HOME/.config/git/allowed_signers"
link "$HOME_CONFIG_ROOT/git/dotfiles.gitconfig" "$HOME/.config/git/dotfiles.gitconfig"

# Profile configs selected by LocalHostName (set via: sudo scutil --set LocalHostName <machine>)
if [[ "$DOTFILES_TARGET" == "darwin" ]]; then
  if [[ -f "$HOME_CONFIG_ROOT/git/$MACHINE_PROFILE.gitconfig" ]]; then
    link "$HOME_CONFIG_ROOT/git/$MACHINE_PROFILE.gitconfig" "$HOME/.config/git/machine.gitconfig"
  else
    echo "No Git config for profile '${MACHINE_PROFILE:-unknown}' — set LocalHostName or add home/.config/git/$MACHINE_PROFILE.gitconfig"
  fi
  if [[ -f "$APP_CONFIG_ROOT/1password/agent.$MACHINE_PROFILE.toml" ]]; then
    link "$APP_CONFIG_ROOT/1password/agent.$MACHINE_PROFILE.toml" "$HOME/.config/1Password/ssh/agent.toml"
  fi
fi
link "$HOME_CONFIG_ROOT/zed/settings.json" "$HOME/.config/zed/settings.json"
link "$HOME_CONFIG_ROOT/opencode/opencode.json" "$HOME/.config/opencode/opencode.json"

bootstrap_neovim

link "$APP_CONFIG_ROOT/ghostty/config" "$DOTFILES_GHOSTTY_CONFIG_PATH"
link "$APP_CONFIG_ROOT/vscode-insiders/User/settings.json" "$DOTFILES_VSCODE_USER_DIR/settings.json"

if [[ -f "$APP_CONFIG_ROOT/vscode-insiders/User/keybindings.json" ]]; then
  link "$APP_CONFIG_ROOT/vscode-insiders/User/keybindings.json" "$DOTFILES_VSCODE_USER_DIR/keybindings.json"
fi

if [[ -d "$APP_CONFIG_ROOT/vscode-insiders/User/snippets" ]]; then
  link "$APP_CONFIG_ROOT/vscode-insiders/User/snippets" "$DOTFILES_VSCODE_USER_DIR/snippets"
fi

command -v tldr >/dev/null 2>&1 && tldr --update || true

"$DOTFILES_BIN_DIR/vscode-insiders-extensions" install
"$DOTFILES_BIN_DIR/npm-globals" install
"$DOTFILES_BIN_DIR/gh-extensions" install
"$DOTFILES_BIN_DIR/gh-extensions" upgrade
bootstrap_agent_skills

ln -sfn "$HOME/.config/git/ignore" "$HOME/.gitignore"
