#!/usr/bin/env bash
set -euo pipefail

DOTFILES_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$DOTFILES_BIN_DIR/common.sh"

bootstrap_packages() {
  if [[ "$DOTFILES_TARGET" == "darwin" ]]; then
    local brewfile
    local brewfiles=("$DOTFILES_ROOT/packages/Brewfile")

    if ! xcode-select -p >/dev/null 2>&1; then
      xcode-select --install
      echo "Install Command Line Tools, then re-run ./bin/bootstrap"
      exit 1
    fi

    if ! command -v brew >/dev/null 2>&1; then
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    eval "$(/opt/homebrew/bin/brew shellenv || /usr/local/bin/brew shellenv)"
    if [[ -n "$MACHINE_PROFILE" && -f "$DOTFILES_ROOT/packages/Brewfile.$MACHINE_PROFILE" ]]; then
      brewfiles+=("$DOTFILES_ROOT/packages/Brewfile.$MACHINE_PROFILE")
    else
      echo "No Homebrew profile for '${MACHINE:-unknown}' — installing shared packages only."
    fi
    for brewfile in "${brewfiles[@]}"; do
      brew bundle --file="$brewfile"
    done
    brew upgrade
    report_unmanaged_brew_packages "${brewfiles[@]}"
  else
    echo "Skipping Homebrew package bootstrap for linux."
  fi
}

bootstrap_uv_tools() {
  local manifest="$DOTFILES_ROOT/packages/uv-tools.txt"

  if [[ ! -f "$manifest" ]]; then
    return
  fi

  if ! command -v uv >/dev/null 2>&1; then
    echo "Skipping uv tools bootstrap: uv not available."
    return
  fi

  while IFS= read -r tool; do
    [[ -z "$tool" || "$tool" == \#* ]] && continue
    uv tool install "$tool"
  done < "$manifest"
}

bootstrap_znap() {
  local znap_dir="$HOME/.znap"

  [[ -r "$znap_dir/znap.zsh" ]] ||
    git clone --depth 1 https://github.com/marlonrichert/zsh-snap.git "$znap_dir"

  ZNAP_DIR="$znap_dir" zsh -fc '
    source "$ZNAP_DIR/znap.zsh"
    zstyle ":znap:*" repos-dir "$ZNAP_DIR/repos"
    znap clone \
      Aloxaf/fzf-tab \
      zsh-users/zsh-autosuggestions \
      zdharma-continuum/fast-syntax-highlighting
  '
}

bootstrap_neovim() {
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

  if ! command -v nvim >/dev/null 2>&1; then
    echo "Skipping Neovim bootstrap: nvim not available."
    return
  fi

  local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  rm -rf \
    "$data_home/nvim/site/parser" \
    "$data_home/nvim/lazy/nvim-treesitter/parser"

  nvim --headless -i NONE "+Lazy! restore" "+TSUpdate" +qa
}

bootstrap_touchid_sudo() {
  # /etc/pam.d/sudo_local survives OS updates, unlike /etc/pam.d/sudo
  grep -q '^auth.*pam_tid\.so' /etc/pam.d/sudo_local 2>/dev/null && return 0
  if [[ -f /etc/pam.d/sudo_local.template ]]; then
    echo "Enabling Touch ID for sudo (password prompt expected)…"
    sudo cp /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local
    sudo sed -i '' 's/^#auth/auth/' /etc/pam.d/sudo_local
  fi
}

bootstrap_agent_skills() {
  "$DOTFILES_BIN_DIR/agent-skills" install
  "$DOTFILES_BIN_DIR/agent-skills" upgrade
}

bootstrap_neru_services() {
  command -v neru >/dev/null 2>&1 || return 0
  # `status` exits 0 either way; it prints "Service not loaded" when missing
  if neru services status 2>/dev/null | grep -qi "not loaded"; then
    neru services install
  fi
}

link() {
  local src="$1"
  local target="$2"

  mkdir -p "$(dirname "$target")"
  if [[ -d "$target" && ! -L "$target" ]]; then
    echo "link: '$target' is a real directory — remove manually first" >&2
    return 1
  fi
  ln -sfn "$src" "$target"
}

resolve_target
resolve_machine

if [[ "$DOTFILES_TARGET" == "linux" ]]; then
  # shellcheck source=linux.sh
  source "$DOTFILES_BIN_DIR/linux.sh"
fi

set_platform_paths
if [[ "$DOTFILES_TARGET" == "darwin" ]]; then
  bootstrap_touchid_sudo
fi
bootstrap_packages
bootstrap_uv_tools

if [[ "$DOTFILES_TARGET" == "linux" ]]; then
  bootstrap_linux_tools
fi

bootstrap_znap

link_all link

bootstrap_neovim
bootstrap_neru_services

command -v tldr >/dev/null 2>&1 && tldr --update || true

"$DOTFILES_BIN_DIR/vscode-insiders-extensions" install
"$DOTFILES_BIN_DIR/npm-globals" install
"$DOTFILES_BIN_DIR/gh-extensions" install
"$DOTFILES_BIN_DIR/gh-extensions" upgrade
bootstrap_agent_skills
