tap "krishkrosh/apps", trusted: true
tap "ddalcu/mlx-serve", "https://github.com/ddalcu/mlx-serve", trusted: true

brew "exiftool"
brew "ffmpeg-full"
brew "libheif"

# Standalone ad blocker
cask "adguard"
# Privacy-focused VPN client
cask "adguard-vpn"
# Scriptable scratchpad for developers
cask "boop"
# OpenAI's desktop app, including the Codex experience
cask "chatgpt"
# Remote desktop host from Google
cask "chrome-remote-desktop-host"
# OpenAI Codex terminal agent
cask "codex"
# Menu bar app for monitoring Codex usage
cask "codexbar"
# Disk usage utility
cask "disk-inventory-x"
# Cloud file synchronization client
cask "dropbox"
# Video tooling utility
cask "flixtools"
# Garmin device management and updates
cask "garmin-express"
# Free and open-source media player
cask "iina"
# Screen recorder and capture tool
cask "kap"
# Local-network file transfer tool
cask "localsend"
cask "mlx-core"
# Calculator and converter application
cask "numi"
# Knowledge base and Markdown editor
cask "obsidian"
# Audio editor and recorder
cask "ocenaudio"
# Microsoft cloud file synchronization client
cask "onedrive"
# PHP IDE by JetBrains
cask "phpstorm"
# Faster markdownlint
cask "rumdl"
# Game platform
cask "steam"
# Mesh VPN based on WireGuard
cask "tailscale-app"
# Messaging app with a focus on speed and security
cask "telegram"
# BitTorrent client
cask "transmission"
